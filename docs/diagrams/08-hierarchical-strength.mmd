flowchart TB
  POP[population mean rate] --> PRIOR[prior]
  PRIOR --> P1[player 1 posterior]
  PRIOR --> P2[player 2 posterior]
  E1[exposure 1 small] -->|shrink strongly| P1
  E2[exposure 2 large] -->|trust own rate| P2
  R1[raw rate 1] --> P1
  R2[raw rate 2] --> P2
  P1 --> RANK[ranking with exposure disclosed]
  P2 --> RANK
